{
  "name": "apex-training",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 3100",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3101",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:remote": "node scripts/test-remote.mjs",
    "lint": "eslint . && tsc --noEmit",
    "check:subpath": "node scripts/check-subpath.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.7",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
